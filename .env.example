# ============================================================
# Rail and Road-based Supply Chain Distribution System
# Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control.
# ============================================================

# ------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------
# When running with Docker Compose, POSTGRES_HOST must be the
# Docker service name ("postgres"), not "localhost". Inside the
# Docker network, containers talk to each other using their
# service names as hostnames.
#
# When running locally without Docker, use "localhost".
# ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=scds
POSTGRES_USER=scds_user
POSTGRES_PASSWORD=change_me_to_a_strong_password

# ------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------
BACKEND_PORT=3000
NODE_ENV=development

# ------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ------------------------------------------------------------
JWT_SECRET=change_me_to_a_random_secret_key
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------
# CORS — Frontend URL
# ------------------------------------------------------------
# The frontend origin allowed to make credentialed requests.
# Must match exactly (protocol + host + port).
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
